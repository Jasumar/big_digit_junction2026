# Copy to .env and fill in locally. Never commit .env. The server reads real environment
# variables; export these (or `set -a; source .env; set +a`) before starting it.
# A key added here is a shared surface: add it in the same commit as the code using it.
PORT=8000
# stub (offline rules, default), modal (Gemma on Modal, keys below) or openrouter (hosted model)
AI_PROVIDER=stub
# OpenRouter (AI_PROVIDER=openrouter). Key from https://openrouter.ai/keys. Empty = the
# server refuses to start; keep AI_PROVIDER=stub to run offline.
OPENROUTER_API_KEY=
# Default google/gemma-4-26b-a4b-it. Any OpenRouter model slug works.
OPENROUTER_MODEL=
# Path to the SQLite store; empty = packages/cloud/data/s_pankki.sqlite
SPANKKI_DB=
# Set to 1 on the demo machine: refuse to start on the 6-customer sample
REQUIRE_FULL_DATA=
# Gemma on Modal (AI_PROVIDER=modal). URL from `modal deploy apps/ai/modal_app.py`,
# key = the VLLM_API_KEY you put in the Modal secret "coach-llm-key". Never commit them.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemma
# Seconds per model call; a cold start can take minutes
AI_TIMEOUT=120
